<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• FRONT CAMERA â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <!-- FIX: Added inertial block (was missing, causing URDF parse errors).
       Added optical frame joint (required for ROS image_transport / camera_info).
       Added camera distortion model matching training data collection setup.
       Camera tilted 15Â° downward for target visibility during approach. -->
  <xacro:macro name="camera_sensor" params="parent">
    <link name="camera_link">
      <inertial>
        <mass value="0.035"/>
        <inertia ixx="1e-6" ixy="0" ixz="0"
                 iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
      <visual>
        <geometry><box size="0.04 0.06 0.03"/></geometry>
        <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.04 0.06 0.03"/></geometry>
      </collision>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <!-- 15-degree downward pitch for target tracking during hover -->
      <origin xyz="0.22 0 -0.02" rpy="0 0.2618 0"/>
    </joint>

    <!-- FIX: Optical frame required by ROS image_transport convention -->
    <link name="camera_optical_link"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_link"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="front_camera" type="camera">
        <update_rate>30</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <!-- FIX: Distortion model added to match real sensor characteristics -->
          <distortion>
            <k1>-0.25</k1><k2>0.12</k2><k3>0.0</k3>
            <p1>-0.00028</p1><p2>-0.00005</p2>
            <center>0.5 0.5</center>
          </distortion>
        </camera>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_optical_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• IMU SENSOR â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <!-- FIX: IMU was completely missing from original sensors.urdf.xacro.
       Required for odometry, EKF, and altitude hold. Noise parameters
       modelled on MPU-6000 datasheet. -->
  <xacro:macro name="imu_sensor" params="parent">
    <link name="imu_link">
      <inertial>
        <mass value="0.015"/>
        <inertia ixx="1e-7" ixy="0" ixz="0"
                 iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <update_rate>400</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <topic>/imu</topic>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
