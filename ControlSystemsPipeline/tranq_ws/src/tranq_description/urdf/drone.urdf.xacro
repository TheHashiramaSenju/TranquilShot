<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tranq_drone">
  <xacro:include filename="$(find tranq_description)/urdf/base.urdf.xacro"/>
  <xacro:include filename="$(find tranq_description)/urdf/sensors.urdf.xacro"/>
  <xacro:camera_sensor parent="base_link"/>
  <xacro:tof_sensor parent="base_link" name="tof_center" topic="/range_1" xyz="0.18 0.0 -0.02" rpy="0 1.5708 0"/>
  <xacro:tof_sensor parent="base_link" name="tof_offset" topic="/range_2" xyz="0.18 0.0 -0.12" rpy="0 1.5708 0"/>
</robot>
