<?xml version="1.0"?>
<sdf version="1.9">
  <world name="elephant_field">

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• SYSTEM PLUGINS â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• PHYSICS â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <physics type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• SCENE / LIGHTING â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <scene>
      <ambient>0.85 0.85 0.85 1</ambient>
      <background>0.53 0.81 0.98 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
      <sky>
        <time>10</time>
        <sunrise>6</sunrise>
        <sunset>20</sunset>
      </sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>1.0 0.97 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.35 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.4 0.45 0.55 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.35 -0.1 -0.9</direction>
    </light>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• GROUND PLANE â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
            <contact><ode/></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.65 0.45 1</ambient>
            <diffuse>0.75 0.65 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://tranq_description/materials/textures/savanna_ground_albedo.jpg</albedo_map>
                <normal_map>model://tranq_description/materials/textures/savanna_ground_normal.jpg</normal_map>
                <roughness_map>model://tranq_description/materials/textures/savanna_ground_rough.jpg</roughness_map>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• VEGETATION â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <model name="acacia_tree_01">
      <static>true</static>
      <pose>18 12 0 0 0 0.4</pose>
      <link name="trunk">
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.25</radius><length>5.0</length></cylinder></geometry>
          <pose>0 0 2.5 0 0 0</pose>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.45 0.3 0.15 1</diffuse></material>
        </visual>
        <collision name="trunk_col">
          <geometry><cylinder><radius>0.25</radius><length>5.0</length></cylinder></geometry>
          <pose>0 0 2.5 0 0 0</pose>
        </collision>
        <visual name="canopy_vis">
          <geometry><sphere><radius>3.5</radius></sphere></geometry>
          <pose>0 0 6.5 0 0 0</pose>
          <material>
            <ambient>0.25 0.48 0.18 0.85</ambient>
            <diffuse>0.3 0.55 0.22 0.85</diffuse>
          </material>
        </visual>
        <inertial><mass>0.001</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
      </link>
    </model>

    <model name="acacia_tree_02">
      <static>true</static>
      <pose>-15 22 0 0 0 1.2</pose>
      <link name="trunk">
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.22</radius><length>4.5</length></cylinder></geometry>
          <pose>0 0 2.25 0 0 0</pose>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.45 0.3 0.15 1</diffuse></material>
        </visual>
        <collision name="trunk_col">
          <geometry><cylinder><radius>0.22</radius><length>4.5</length></cylinder></geometry>
          <pose>0 0 2.25 0 0 0</pose>
        </collision>
        <visual name="canopy_vis">
          <geometry><sphere><radius>3.0</radius></sphere></geometry>
          <pose>0 0 5.8 0 0 0</pose>
          <material>
            <ambient>0.27 0.5 0.2 0.9</ambient>
            <diffuse>0.32 0.58 0.23 0.9</diffuse>
          </material>
        </visual>
        <inertial><mass>0.001</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
      </link>
    </model>

    <model name="acacia_tree_03">
      <static>true</static>
      <pose>30 -10 0 0 0 2.7</pose>
      <link name="trunk">
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.3</radius><length>6.0</length></cylinder></geometry>
          <pose>0 0 3.0 0 0 0</pose>
          <material><ambient>0.42 0.28 0.14 1</ambient><diffuse>0.42 0.28 0.14 1</diffuse></material>
        </visual>
        <collision name="trunk_col">
          <geometry><cylinder><radius>0.3</radius><length>6.0</length></cylinder></geometry>
          <pose>0 0 3.0 0 0 0</pose>
        </collision>
        <visual name="canopy_vis">
          <geometry><sphere><radius>4.2</radius></sphere></geometry>
          <pose>0 0 8.0 0 0 0</pose>
          <material>
            <ambient>0.22 0.44 0.16 0.88</ambient>
            <diffuse>0.28 0.52 0.20 0.88</diffuse>
          </material>
        </visual>
        <inertial><mass>0.001</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
      </link>
    </model>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• ELEPHANT MODEL â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <model name="african_elephant_01">
      <static>false</static>
      <pose>12 8 0 0 0 -1.57</pose>
      <link name="body">
        <inertial>
          <mass>4000.0</mass>
          <inertia>
            <ixx>3200</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>5000</iyy><iyz>0</iyz><izz>4500</izz>
          </inertia>
        </inertial>
        <visual name="body_vis">
          <geometry><box><size>4.5 2.2 2.8</size></box></geometry>
          <pose>0 0 1.4 0 0 0</pose>
          <material>
            <ambient>0.38 0.35 0.32 1</ambient>
            <diffuse>0.4 0.37 0.34 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <visual name="head_vis">
          <geometry><sphere><radius>0.85</radius></sphere></geometry>
          <pose>2.4 0 2.2 0 0 0</pose>
          <material><ambient>0.36 0.33 0.30 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material>
        </visual>
        <visual name="trunk_vis">
          <geometry><cylinder><radius>0.22</radius><length>2.0</length></cylinder></geometry>
          <pose>2.9 0 1.5 1.2 0 0</pose>
          <material><ambient>0.36 0.33 0.30 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material>
        </visual>
        <visual name="leg_fl">
          <geometry><cylinder><radius>0.28</radius><length>1.4</length></cylinder></geometry>
          <pose>1.5 0.7 0.7 0 0 0</pose>
          <material><ambient>0.36 0.33 0.30 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material>
        </visual>
        <visual name="leg_fr">
          <geometry><cylinder><radius>0.28</radius><length>1.4</length></cylinder></geometry>
          <pose>1.5 -0.7 0.7 0 0 0</pose>
          <material><ambient>0.36 0.33 0.30 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material>
        </visual>
        <visual name="leg_rl">
          <geometry><cylinder><radius>0.28</radius><length>1.4</length></cylinder></geometry>
          <pose>-1.5 0.7 0.7 0 0 0</pose>
          <material><ambient>0.36 0.33 0.30 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material>
        </visual>
        <visual name="leg_rr">
          <geometry><cylinder><radius>0.28</radius><length>1.4</length></cylinder></geometry>
          <pose>-1.5 -0.7 0.7 0 0 0</pose>
          <material><ambient>0.36 0.33 0.30 1</ambient><diffuse>0.38 0.35 0.32 1</diffuse></material>
        </visual>
        <collision name="body_col">
          <geometry><box><size>5.0 2.5 3.0</size></box></geometry>
          <pose>0 0 1.5 0 0 0</pose>
        </collision>
      </link>
      <plugin filename="gz-sim-trajectory-follower-system"
              name="gz::sim::systems::TrajectoryFollower">
        <link_name>body</link_name>
        <loop>true</loop>
        <tension>0.0</tension>
        <v>0.3</v>
        <w>0.05</w>
        <waypoints>
          <waypoint>12 8 0</waypoint>
          <waypoint>20 5 0</waypoint>
          <waypoint>18 -3 0</waypoint>
          <waypoint>10 -5 0</waypoint>
          <waypoint>5 2 0</waypoint>
          <waypoint>12 8 0</waypoint>
        </waypoints>
      </plugin>
    </model>

  </world>
</sdf>
